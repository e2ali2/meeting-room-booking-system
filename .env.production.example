DB_HOST=postgres
DB_PORT=5432
DB_NAME=meeting_room_booking
DB_USER=meeting_app
DB_PASSWORD=generate_a_long_random_database_password

RABBITMQ_HOST=rabbitmq
OUTBOX_POLL_INTERVAL_SECONDS=5

SMTP_HOST=smtp-provider.example
SMTP_PORT=587
SMTP_USER=replace_with_smtp_login
SMTP_PASSWORD=replace_with_smtp_secret
SMTP_FROM=booking@meetingsystem.ru
SMTP_SECURITY=starttls

DEMO_AUTH_ENABLED=true
DEMO_EMPLOYEE_ID=
CORS_ORIGINS=https://meetingsystem.ru,https://www.meetingsystem.ru
