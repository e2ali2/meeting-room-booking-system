@startuml
title C4 Level 1 — System Context\nMeeting Room Booking System

left to right direction

actor "Employee" as Employee
actor "Administrator" as Admin

rectangle "Meeting Room Booking System" as MRBS {
}

rectangle "Email Provider" as Email <<External System>>

