@startuml
title C4 Level 3 — Component Diagram\nFastAPI Backend

top to bottom direction

skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 55
skinparam rectangle {
    Padding 15
}

rectangle "Web Frontend\n[External Container]" as Frontend

rectangle "FastAPI Backend" {

    rectangle "Bookings API\nCreate, modify, cancel\nand view bookings" as Bookings

    rectangle "Room Availability API\nSearch available rooms\nand apply filters" as Rooms

    rectangle "Office & Equipment API\nReference data" as Reference

    rectangle "Admin API\nManage offices, rooms,\nequipment and bookings" as Admin

    rectangle "Booking Validation\nBusiness rules and\navailability checks" as Validation

    rectangle "Audit Logging\nRecords administrative actions" as Audit

    rectangle "Outbox Event Creation\nCreates notification events" as Outbox

    rectangle "Database Access\nSQLAlchemy" as Persistence
}

database "PostgreSQL\n[External Container]" as DB

Frontend --> Bookings : REST
Frontend --> Rooms : REST
Frontend --> Reference : REST
Frontend --> Admin : REST

Bookings --> Validation
Bookings --> Outbox
Bookings --> Persistence

Rooms --> Persistence

Reference --> Persistence

Admin --> Validation
Admin --> Audit
Admin --> Persistence

Validation --> Persistence
Audit --> Persistence
Outbox --> Persistence

Persistence --> DB

@enduml