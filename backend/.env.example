DB_HOST=localhost
DB_PORT=5432
DB_NAME=meeting_room_booking
DB_USER=postgres
DB_PASSWORD=your_database_password
# Optional full connection string used by cloud PostgreSQL providers.
DATABASE_URL=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_SECURITY=starttls

# Use `unisender_api` on Vercel; keep `rabbitmq` for the local architecture demo.
NOTIFICATION_DELIVERY=rabbitmq
UNISENDER_API_KEY=
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1/email/send.json
EMAIL_FROM=booking@meetingsystem.ru
EMAIL_FROM_NAME=Meeting Room Booking

RABBITMQ_HOST=localhost
OUTBOX_POLL_INTERVAL_SECONDS=5

# Temporary public-demo identity adapter. Disable when corporate OIDC/JWT is connected.
DEMO_AUTH_ENABLED=true
# Optional: EMP-1001 in the original local DB, EMP1001 in a fresh seed.
DEMO_EMPLOYEE_ID=

# Comma-separated frontend origins. Same-origin FastAPI UI works without changes.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
